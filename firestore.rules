rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles collection
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId);
      allow delete: if false;
    }

    // Club members collection
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(memberId);
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(eventId);
    }

    // Treasury transactions collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(transactionId);
    }
  }
}

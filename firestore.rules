rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles collection
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId);
      allow delete: if false;
    }

    // Club members collection
    match /members/{memberId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(memberId);
    }

    // Events collection
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(eventId);
    }

    // Treasury transactions collection
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(transactionId);
    }
  }
}
